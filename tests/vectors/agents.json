  {
    "name": "Anthropic content blocks",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Look up order W-1234567"
          }
        ]
      },
      {
        "role": "assistant",
        "content": [
          {
            "type": "tool_use",
            "id": "t1",
            "name": "get_order",
            "input": {
              "order_id": "W-1234567"
            }
          }
        ]
      },
      {
        "role": "user",
        "content": [
          {
            "type": "tool_result",
            "tool_use_id": "t1",
            "content": "{\"customer\": \"cus_77812\"}"
          }
        ]
      },
      {
        "role": "assistant",
        "content": [
          {
            "type": "tool_use",
            "id": "t2",
            "name": "email",
            "input": {
              "customer": "cus_77821"
            }
          }
        ]
      }
    ],
    "expect": {
      "unsourced": [
        "email.customer"
      ]
    }
  },
