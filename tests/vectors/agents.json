[
  {
    "name": "an identifier copied from a tool result is sourced",
    "messages": [
      {
        "role": "user",
        "content": "Refund my last order."
      },
      {
        "role": "assistant",
        "content": null,
        "tool_calls": [
          {
            "id": "1",
            "function": {
              "name": "get_orders",
              "arguments": "{\"user_id\": \"mia_li_3668\"}"
            }
          }
        ]
      },
      {
        "role": "tool",
        "tool_call_id": "1",
        "content": "{\"orders\": [{\"id\": \"ORD-88213\", \"total\": 49.99}]}"
      },
      {
        "role": "assistant",
        "content": null,
        "tool_calls": [
          {
            "id": "2",
            "function": {
              "name": "refund",
              "arguments": "{\"order_id\": \"ORD-88213\", \"amount\": 49.99}"
            }
          }
        ]
      }
    ],
    "expect": {
      "unsourced": [
        "get_orders.user_id"
      ]
    }
  },
